# Copiez ce fichier en « .env.local » (ignoré par git) et remplissez VOS clés.
# Récupérez-les sur dashboard.flutterwave.com → Settings → API Keys (mode SANDBOX).
# FLW_MODE = sandbox pour les tests, live pour la production.

FLW_SECRET_KEY=remplacez-moi-cle-privee
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx
FLW_ENCRYPTION_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
FLW_WEBHOOK_SECRET=mon_webhook_secret_hash_a_definir
FLW_MODE=sandbox

# Optionnel : clé de transfert séparée (si votre compte Flutterwave en exige une)
FLW_TRANSFER_SECRET=
