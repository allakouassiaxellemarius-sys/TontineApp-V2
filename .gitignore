# Local Netlify folder
.netlify

# Secrets & signature — ne jamais versionner
keystore/
*.jks
*.keystore
keystore.properties
password.txt
local.properties
.env
.env.*
*.pem
*.key

# Node / builds
node_modules/
dist/
dist-apk/
netlify-update/

# Wrangler (Cloudflare) — cache local
.wrangler/

# Config Firebase Android reconstituée localement (non versionnée)
android/app/google-services.json

# Logs de build
*.log
apk.log
build.log
tail.log

# Le template d'exemple est versionne (sans secrets) ; les vrais .env restent ignores
!.env.local.example
