{
    "name": "tontine-manager",
    "productName": "Tontine Manager",
    "description": "Application mobile de gestion de tontine : membres, tours, rappels WhatsApp/SMS, pénalités, historique et export PDF/Excel",
    "private": true,
    "version": "2.3.11",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "cap:init": "npx cap init TontineManager com.tontine.manager --web-dir dist",
        "cap:add:android": "npx cap add android",
        "cap:add:ios": "npx cap add ios",
        "cap:sync": "npx cap sync",
        "cap:copy": "npx cap copy android",
        "cap:sync:ios": "npx cap sync ios",
        "postinstall": "patch-package",
        "apk:debug": "vite build && npx cap sync android && cd android && gradlew.bat assembleDebug",
        "apk:release": "vite build && npx cap sync android && cd android && gradlew.bat assembleRelease",
        "deploy:phone": "powershell -ExecutionPolicy Bypass -File deploy-phone.ps1"
    },
    "dependencies": {
        "@capacitor/app": "^8.0.0",
        "@capacitor/filesystem": "^8.0.0",
        "@capacitor/local-notifications": "^8.0.0",
        "@capacitor/push-notifications": "^8.0.0",
        "@capacitor/share": "^8.0.0",
        "@capgo/capacitor-native-biometric": "^8.0.0",
        "@capgo/capacitor-updater": "^8.0.0",
        "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
        "firebase": "^12.17.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^0.468.0",
        "qrcode": "^1.5.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.1",
        "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
    },
    "devDependencies": {
        "@capacitor/android": "^8.0.0",
        "@capacitor/cli": "^8.0.0",
        "@capacitor/core": "^8.0.0",
        "@capacitor/ios": "^8.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "jsdom": "^24.1.3",
        "patch-package": "^8.0.1",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^7.0.2",
        "vite": "^6.0.7"
    }
}
