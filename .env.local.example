# Copiez ce fichier en « .env.local » (ignoré par git) et remplissez VOS clés.
# Récupérez-les sur dashboard.flutterwave.com → Settings → API Keys (mode SANDBOX).
# FLW_MODE = sandbox pour les tests, live pour la production.

FLW_SECRET_KEY=remplacez-moi-cle-privee
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxx
FLW_ENCRYPTION_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxx
FLW_WEBHOOK_SECRET=mon_webhook_secret_hash_a_definir
FLW_MODE=sandbox

# Optionnel : clé de transfert séparée (si votre compte Flutterwave en exige une)
FLW_TRANSFER_SECRET=

# ─── Firebase (notifications push Web / PWA) ───
# Valeurs PUBLIQUES (côté client). Console Firebase → Paramètres du projet
# → Vos applications → (Web). La clé VAPID : Cloud Messaging → Paires de clés VAPID Web.
# Le worker tontine-sync a besoin du secret FCM_SERVICE_ACCOUNT (wrangler secret put)
# pointant vers le MÊME projet pour envoyer les notifications.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
