{
  "rules": {
    "tontines": {
      "$tontineId": {
        ".read": true,
        ".write": "auth != null && ((newData.exists() && newData.child('groupe').child('proprietaire').val() === auth.uid && (!data.exists() || data.child('groupe').child('proprietaire').val() === auth.uid)) || (!newData.exists() && data.child('groupe').child('proprietaire').val() === auth.uid))"
      }
    },
    "demandes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (newData.exists() || root.child('tontines').child($code).child('groupe').child('proprietaire').val() === auth.uid)"
      }
    },
    "messages_utilisateur": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (newData.exists() || root.child('tontines').child($code).child('groupe').child('proprietaire').val() === auth.uid)"
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
