# Copiez ce fichier en « .env.local » (ignoré par git) et remplissez VOS clés.
# Aucun secret de passerelle de paiement n'est requis : l'app ne collecte
# jamais l'argent, le membre paie sur le lien de paiement SasPay du responsable.

# ─── Firebase (notifications push Web / PWA) ───
# Valeurs PUBLIQUES (côté client). Console Firebase → Paramètres du projet
# → Vos applications → (Web). La clé VAPID : Cloud Messaging → Paires de clés VAPID Web.
# Le worker tontine-sync a besoin du secret FCM_SERVICE_ACCOUNT (wrangler secret put)
# pointant vers le MÊME projet pour envoyer les notifications.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Client OAuth Google Web utilisé par le bouton « Se connecter avec Google ».
# Il doit avoir l'origine de l'application autorisée dans Google Cloud Console.
VITE_GOOGLE_WEB_CLIENT_ID=793106571941-tva6kieobdac95diafgcl2ot2q9ucap5.apps.googleusercontent.com
