{
    "name": "tontine-manager",
    "productName": "Tontine Manager",
    "description": "Application mobile de gestion de tontine : membres, tours, rappels WhatsApp/SMS, pénalités, historique et export PDF/Excel",
    "private": true,
    "version": "1.19.20",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "cap:init": "npx cap init TontineManager com.tontine.manager --web-dir dist",
        "cap:add:android": "npx cap add android",
        "cap:add:ios": "npx cap add ios",
        "cap:sync": "npx cap sync",
        "cap:copy": "npx cap copy android",
        "cap:sync:ios": "npx cap sync ios",
        "postinstall": "patch-package",
        "apk:debug": "vite build && npx cap sync android && cd android && gradlew.bat assembleDebug",
        "apk:release": "vite build && npx cap sync android && cd android && gradlew.bat assembleRelease"
    },
    "dependencies": {
        "@capacitor/filesystem": "^6.0.4",
        "@capacitor/local-notifications": "^6.1.3",
        "@capacitor/push-notifications": "^6.0.5",
        "@capacitor/share": "^6.0.4",
        "@capgo/capacitor-native-biometric": "^6.0.4",
        "@capgo/capacitor-updater": "^6.50.2",
        "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
        "firebase": "^12.17.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.8",
        "lucide-react": "^0.468.0",
        "qrcode": "^1.5.4",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.1",
        "xlsx": "^0.18.5"
    },
    "devDependencies": {
        "@capacitor/android": "^6.2.1",
        "@capacitor/cli": "^6.2.1",
        "@capacitor/core": "^6.2.1",
        "@capacitor/ios": "^6.2.1",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "jsdom": "^24.1.3",
        "patch-package": "^8.0.1",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.17",
        "typescript": "^7.0.2",
        "vite": "^6.0.7"
    }
}
